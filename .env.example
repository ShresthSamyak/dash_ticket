# Copy this file to ".env" and fill in the values you need.
# .env holds secrets and is git-ignored — never commit the real one.

# ── Automatiq API token (Company Settings -> API) ──
# Required when config.yaml has "source: automatiq". Not needed for mock mode.
AUTOMATIQ_API_TOKEN=

# ── Optional: Slack alerts ──
# Create an "Incoming Webhook" in Slack and paste the URL here.
SLACK_WEBHOOK_URL=

# ── Optional: Email alerts (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
